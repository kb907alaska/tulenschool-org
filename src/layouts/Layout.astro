---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Tułen Charter School | Public K-4 Dena'ina Culture & Academic Charter in Kenai, AK",
  description = "Tułen Charter School is a public K-4 charter school in Kenai, Alaska operated in partnership with the Kenaitze Indian Tribe and KPBSD, combining academic excellence with Dena'ina language, culture, and subsistence stewardship.",
  image = "/images/hero-river.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://tulenschool.org");
---

<!usr/bin/env html>
<html lang="en" class="h-full bg-sand">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="Tulen Charter School, Tułen, Kenai Alaska Charter School, Kenaitze Indian Tribe, KPBSD, Dena'ina culture, K-4 school Kenai, subsistence education" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  </head>
  <body class="flex flex-col min-h-screen text-slate-800 antialiased bg-sand selection:bg-teal-700 selection:text-white">
    <AnnouncementBanner />
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
