---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us & Directions | Tułen Charter School"
  description="Contact Tułen Charter School in Kenai, AK. Phone: (907) 335-2829. Address: 12271 Kenai Spur Highway, Kenai, AK 99611."
>
  
  <!-- PAGE HEADER -->
  <section class="bg-teal-950 text-white py-16 sm:py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold uppercase tracking-wider">
        Get In Touch
      </div>
      <h1 class="font-serif font-extrabold text-4xl sm:text-5xl text-white tracking-tight">
        Contact Tułen Charter School
      </h1>
      <p class="text-slate-200 text-base sm:text-lg max-w-3xl font-normal leading-relaxed">
        Have questions about enrollment, campus visits, or our academic program? We are here to help!
      </p>
    </div>
  </section>

  <!-- CONTACT CONTENT GRID -->
  <section class="py-16 sm:py-24 bg-sand">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Contact Details -->
        <div class="lg:col-span-5 space-y-8">
          <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
            <h3 class="font-serif font-bold text-2xl text-teal-950">Campus Information</h3>

            <div class="space-y-4 text-xs sm:text-sm text-slate-700">
              <div class="flex items-start gap-3">
                <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-900 font-bold flex items-center justify-center shrink-0">📍</span>
                <div>
                  <strong class="text-teal-950 block">Campus Address</strong>
                  <span>Kahtnuht’ana Duhdeldiht Campus</span><br />
                  <span>12271 Kenai Spur Highway, Kenai, AK 99611</span>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-900 font-bold flex items-center justify-center shrink-0">📞</span>
                <div>
                  <strong class="text-teal-950 block">Main Office Phone</strong>
                  <a href="tel:9073352829" class="text-teal-900 font-bold hover:underline">(907) 335-2829</a>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-900 font-bold flex items-center justify-center shrink-0">✉️</span>
                <div>
                  <strong class="text-teal-950 block">Email Inquiries</strong>
                  <a href="mailto:info@tulenschool.org" class="text-teal-900 font-bold hover:underline">info@tulenschool.org</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-900 font-bold flex items-center justify-center shrink-0">⏰</span>
                <div>
                  <strong class="text-teal-950 block">Office Hours</strong>
                  <span>Monday &ndash; Friday: 8:00 AM &ndash; 4:00 PM</span><br />
                  <span class="text-xs text-slate-500">Closed on District Holidays & Subsistence Week</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Principal Direct Contact Box -->
          <div class="bg-teal-950 text-white p-8 rounded-3xl space-y-3 shadow-md border border-teal-800">
            <span class="text-xs font-bold uppercase tracking-widest text-amber-400">Direct Principal Line</span>
            <h4 class="font-serif font-bold text-xl text-white">Kimberly Daniels</h4>
            <p class="text-xs text-teal-200">Principal / Head of School</p>
            <p class="text-xs text-slate-300">Email: <a href="mailto:kdaniels@kpbsd.k12.ak.us" class="text-amber-300 font-semibold underline">kdaniels@kpbsd.k12.ak.us</a></p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-7">
          <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-xl space-y-6">
            <h3 class="font-serif font-bold text-2xl text-teal-950 border-l-4 border-amber-500 pl-3">
              Send Us a Message
            </h3>
            <p class="text-xs sm:text-sm text-slate-600">
              Fill out the form below and our administrative team will get back to you within 1 business day.
            </p>

            <form class="space-y-4" onsubmit="event.preventDefault(); alert('Chin\'an! Your message has been sent to our campus office.');">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">First Name *</label>
                  <input type="text" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-700 outline-none text-slate-900" placeholder="Jane" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Last Name *</label>
                  <input type="text" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-700 outline-none text-slate-900" placeholder="Doe" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Email Address *</label>
                  <input type="email" required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-700 outline-none text-slate-900" placeholder="jane@example.com" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Phone Number</label>
                  <input type="tel" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-700 outline-none text-slate-900" placeholder="(907) 555-0100" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Inquiry Topic</label>
                <select class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-700 outline-none text-slate-900">
                  <option>General Information</option>
                  <option>K-4 Enrollment & Lottery</option>
                  <option>APC Governance / Public Comment</option>
                  <option>Campus Tour Request</option>
                  <option>Special Education Services</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Message *</label>
                <textarea rows={4} required class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-700 outline-none text-slate-900" placeholder="How can we assist your family?"></textarea>
              </div>

              <button type="submit" class="w-full py-3.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl shadow-md transition-all">
                Send Message
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
