---
import Layout from '../layouts/Layout.astro';
import { boardMembers, apcMeetingArchive, apcGovernanceDocs } from '../data/apcData';
---

<Layout
  title="Academic Policy Committee (APC) Board | Tułen Charter School"
  description="Governance, bylaws, meeting agendas, minutes, and board representation for the Tułen Charter School Academic Policy Committee in Kenai, AK."
>
  
  <!-- PAGE HEADER -->
  <section class="bg-teal-950 text-white py-16 sm:py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold uppercase tracking-wider">
        School Governance & Oversight
      </div>
      <h1 class="font-serif font-extrabold text-4xl sm:text-5xl text-white tracking-tight">
        Academic Policy Committee (APC)
      </h1>
      <p class="text-slate-200 text-base sm:text-lg max-w-3xl font-normal leading-relaxed">
        The Academic Policy Committee serves as the governing board of Tułen Charter School, responsible for strategic vision, policy adoption, charter compliance, and fiscal oversight in partnership with KPBSD and Kenaitze Indian Tribe.
      </p>
    </div>
  </section>

  <!-- APC BOARD MEMBERS -->
  <section class="py-16 sm:py-24 bg-sand border-b border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700">Governance Board</span>
        <h2 class="font-serif font-bold text-3xl sm:text-4xl text-teal-950">
          APC Board Representation
        </h2>
        <p class="text-sm text-slate-600">
          Composed of Tribal Council representatives, KPBSD leaders, parents, teachers, and community elders.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {boardMembers.map((member) => (
          <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xs hover:shadow-md transition-all space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 bg-amber-100 text-amber-900 text-[10px] font-bold uppercase tracking-wider rounded-full">
                {member.termEnds}
              </span>
              <span class="w-8 h-8 rounded-full bg-teal-900 text-amber-400 font-serif font-bold flex items-center justify-center text-xs">
                APC
              </span>
            </div>
            <div>
              <h3 class="font-serif font-bold text-xl text-teal-950">{member.name}</h3>
              <p class="text-xs font-bold text-amber-700 mt-0.5">{member.role}</p>
              <p class="text-xs text-slate-500 mt-1">{member.affiliation}</p>
            </div>
            {member.email && (
              <div class="pt-3 border-t border-slate-100 text-xs">
                <a href={`mailto:${member.email}`} class="text-teal-900 hover:text-amber-600 font-semibold">
                  ✉️ {member.email}
                </a>
              </div>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- MEETING AGENDAS & MINUTES -->
  <section class="py-16 sm:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700">Public Records</span>
          <h2 class="font-serif font-bold text-3xl sm:text-4xl text-teal-950 mt-1">
            Meeting Schedule & Documents
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-2">
            Regular APC meetings are held on the 3rd Tuesday of each month at 5:30 PM at the campus library and via Zoom.
          </p>
        </div>
      </div>

      <div class="bg-sand rounded-3xl p-6 border border-sand-border shadow-xs overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-300 text-xs font-extrabold text-slate-500 uppercase tracking-wider">
              <th class="pb-3 px-4">Date</th>
              <th class="pb-3 px-4">Meeting Title</th>
              <th class="pb-3 px-4">Status</th>
              <th class="pb-3 px-4 text-right">Downloads</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-xs sm:text-sm">
            {apcMeetingArchive.map((meeting) => (
              <tr class="hover:bg-white/60 transition-colors">
                <td class="py-4 px-4 font-bold text-teal-950 whitespace-nowrap">{meeting.date}</td>
                <td class="py-4 px-4 font-medium text-slate-800">{meeting.title}</td>
                <td class="py-4 px-4">
                  <span class={`px-2.5 py-0.5 rounded-full text-[10px] uppercase font-bold ${meeting.status === 'Approved' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-900'}`}>
                    {meeting.status}
                  </span>
                </td>
                <td class="py-4 px-4 text-right whitespace-nowrap space-x-2">
                  <a href={meeting.agendaUrl} class="px-2.5 py-1 bg-teal-900 text-white text-xs font-bold rounded-lg hover:bg-teal-800">
                    Agenda (PDF)
                  </a>
                  <a href={meeting.minutesUrl} class="px-2.5 py-1 bg-amber-600 text-white text-xs font-bold rounded-lg hover:bg-amber-700">
                    Minutes (PDF)
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Governance Documents -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-6">
        {apcGovernanceDocs.map((doc) => (
          <div class="bg-sand p-6 rounded-2xl border border-sand-border space-y-3">
            <h4 class="font-serif font-bold text-teal-950 text-lg">{doc.title}</h4>
            <p class="text-xs text-slate-600 leading-relaxed">{doc.description}</p>
            <a href={doc.fileUrl} class="inline-block text-xs font-bold text-teal-900 underline hover:text-amber-700">
              Download Document PDF &rarr;
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>
