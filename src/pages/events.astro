---
import Layout from '../layouts/Layout.astro';
import { schoolEvents } from '../data/eventsData';
---

<Layout
  title="Events & Community Celebrations | Tułen Charter School"
  description="Explore school events, Native Youth Olympics exhibitions, Elders Storytelling circles, and annual Subsistence Harvest celebrations at Tułen Charter School."
>
  
  <!-- PAGE HEADER -->
  <section class="bg-teal-950 text-white py-16 sm:py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 text-xs font-bold uppercase tracking-wider">
        Community & Traditions
      </div>
      <h1 class="font-serif font-extrabold text-4xl sm:text-5xl text-white tracking-tight">
        School Events & Gatherings
      </h1>
      <p class="text-slate-200 text-base sm:text-lg max-w-3xl font-normal leading-relaxed">
        From our annual Subsistence Harvest Week to Elders storytelling circles and STEAM expos, our campus comes alive with community events.
      </p>
    </div>
  </section>

  <!-- FEATURED SUBSISTENCE WEEK HIGHLIGHT -->
  <section class="py-16 sm:py-24 bg-sand border-b border-sand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-lg grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-md">
            <img src="/images/hero-river.png" alt="Kenai River Subsistence Camp" class="w-full h-80 object-cover" />
          </div>
        </div>
        <div class="lg:col-span-7 space-y-4">
          <span class="px-3 py-1 bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider rounded-full">
            Signature Annual Tradition
          </span>
          <h2 class="font-serif font-bold text-3xl text-teal-950">Annual Fall Subsistence & Harvest Week</h2>
          <p class="text-xs font-bold text-amber-700 uppercase tracking-widest">Labor Day Week &bull; Kenaitze Tribal Fish Camp & Campus</p>
          <p class="text-sm text-slate-700 leading-relaxed">
            During Subsistence Week, regular classroom schedules yield to hands-on cultural immersion. K-4 students and families gather at the Kenai River fish camp to learn salmon smoking, net cleaning, berry preservation, plant identification, and traditional Dena'ina songs.
          </p>
          <div class="pt-2 flex items-center gap-4">
            <a href="/enrollment" class="px-6 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow-md transition-colors">
              Enroll to Participate &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Events List -->
      <div class="space-y-6">
        <h3 class="font-serif font-bold text-2xl text-teal-950">All Scheduled Campus Events</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {schoolEvents.map((event) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-xs hover:shadow-md transition-all space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 bg-teal-100 text-teal-900 text-[10px] font-bold uppercase rounded-full">
                  {event.category}
                </span>
                <span class="text-xs font-bold text-amber-700">{event.date}</span>
              </div>
              <h4 class="font-serif font-bold text-xl text-teal-950">{event.title}</h4>
              <p class="text-xs text-slate-600 leading-relaxed">{event.description}</p>
              <div class="pt-2 text-[11px] text-slate-500 font-medium border-t border-slate-100 flex justify-between">
                <span>⏱ {event.time}</span>
                <span>📍 {event.location}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

</Layout>
