---
---
<footer class="bg-teal-950 text-slate-300 border-t-4 border-amber-600 pt-16 pb-12 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-teal-900">
      
      <!-- Col 1: Identity & Mission -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-amber-500 flex items-center justify-center text-slate-950 font-serif font-bold text-xl shadow-md">
            T
          </div>
          <div>
            <h4 class="font-serif font-bold text-white text-lg leading-tight">Tułen Charter School</h4>
            <p class="text-xs text-amber-400 font-medium">Kenai, Alaska &bull; Public K-4</p>
          </div>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          Grounded in Dena'ina language, culture, and outdoor subsistence learning. Operated through a community partnership between the Kenai Peninsula Borough School District (KPBSD) and the Kenaitze Indian Tribe.
        </p>
        <div class="pt-2 text-xs text-slate-400">
          <p class="italic text-amber-200/90 font-serif">"Tułen" — Dena'ina for "The river will flow / The current is flowing"</p>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h5 class="text-sm font-bold text-white uppercase tracking-wider text-amber-400">Navigation</h5>
        <ul class="space-y-2 text-xs font-medium">
          <li><a href="/about" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; About Tułen</a></li>
          <li><a href="/enrollment" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; K-4 Enrollment & Lottery</a></li>
          <li><a href="/staff" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; Staff Directory</a></li>
          <li><a href="/academic-policy-committee" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; APC Governance Board</a></li>
          <li><a href="/parent-portal" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; Parent Portal & Handbooks</a></li>
          <li><a href="/school-profile" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; School Accountability Profile</a></li>
        </ul>
      </div>

      <!-- Col 3: Community & Governance -->
      <div class="space-y-3">
        <h5 class="text-sm font-bold text-white uppercase tracking-wider text-amber-400">Resources & Calendar</h5>
        <ul class="space-y-2 text-xs font-medium">
          <li><a href="/calendar" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; Academic & Cultural Calendar</a></li>
          <li><a href="/events" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; School Events & Celebrations</a></li>
          <li><a href="/newsletter" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; Monthly Newsletters</a></li>
          <li><a href="https://kpbsd.org" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; KPBSD District Portal &#8599;</a></li>
          <li><a href="https://kenaitze.org" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300 transition-colors flex items-center gap-1.5">&rsaquo; Kenaitze Indian Tribe &#8599;</a></li>
        </ul>
      </div>

      <!-- Col 4: Campus Location & Contact -->
      <div class="space-y-3">
        <h5 class="text-sm font-bold text-white uppercase tracking-wider text-amber-400">Campus Contact</h5>
        <div class="text-xs space-y-2.5 text-slate-300">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>
              Kahtnuht’ana Duhdeldiht Campus<br />
              12271 Kenai Spur Highway<br />
              Kenai, AK 99611
            </span>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:9073352829" class="hover:text-white font-medium">(907) 335-2829</a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@tulenschool.org" class="hover:text-white">info@tulenschool.org</a>
          </p>
          <p class="text-[11px] text-slate-400 pt-1">
            Office Hours: Mon - Fri, 8:00 AM - 4:00 PM
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>&copy; {new Date().getFullYear()} Tułen Charter School. All rights reserved. KPBSD Public Charter School.</p>
      <div class="flex items-center gap-6">
        <a href="/contact" class="hover:text-slate-200">Contact Us</a>
        <a href="/school-profile" class="hover:text-slate-200">Non-Discrimination Policy</a>
        <a href="/academic-policy-committee" class="hover:text-slate-200">APC Bylaws</a>
      </div>
    </div>
  </div>
</footer>
