---
import { MobileNav } from './MobileNav';
---

<header class="sticky top-0 z-40 bg-sand-bg/95 backdrop-blur-md border-b border-teal-900/10 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand & Emblem -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-12 h-12 rounded-xl bg-teal-900 flex items-center justify-center text-amber-400 font-serif font-bold text-2xl shadow-md group-hover:scale-105 transition-transform">
          T
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="font-serif font-extrabold text-teal-950 text-xl tracking-tight leading-none group-hover:text-teal-700 transition-colors">
              Tułen Charter School
            </span>
          </div>
          <span class="text-xs text-amber-800 font-medium tracking-wide mt-0.5">
            Kenai Peninsula Borough School District &bull; Kenaitze Tribe
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-slate-700">
        <a href="/" class="hover:text-teal-900 transition-colors py-1">Home</a>
        <a href="/about" class="hover:text-teal-900 transition-colors py-1">About</a>
        <a href="/enrollment" class="hover:text-teal-900 transition-colors py-1">Enrollment</a>
        <a href="/staff" class="hover:text-teal-900 transition-colors py-1">Staff</a>
        <a href="/academic-policy-committee" class="hover:text-teal-900 transition-colors py-1">APC Board</a>
        <a href="/parent-portal" class="hover:text-teal-900 transition-colors py-1">Parent Portal</a>
        
        <!-- Dropdown for More -->
        <div class="relative group py-1">
          <button class="flex items-center gap-1 hover:text-teal-900 transition-colors">
            <span>Explore</span>
            <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute right-0 top-full hidden group-hover:block w-56 bg-white rounded-xl shadow-xl border border-slate-100 py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-200">
            <a href="/calendar" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-teal-50 hover:text-teal-900 font-medium">School Calendar</a>
            <a href="/events" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-teal-50 hover:text-teal-900 font-medium">Events & Activities</a>
            <a href="/newsletter" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-teal-50 hover:text-teal-900 font-medium">Newsletters</a>
            <a href="/school-profile" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-teal-50 hover:text-teal-900 font-medium">School Profile & Data</a>
            <a href="/contact" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-teal-50 hover:text-teal-900 font-medium">Contact Campus</a>
          </div>
        </div>
      </nav>

      <!-- Action Buttons & Mobile Nav Trigger -->
      <div class="flex items-center gap-3">
        <a
          href="/enrollment"
          class="hidden sm:inline-flex items-center justify-center px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm shadow-sm transition-all hover:shadow-md"
        >
          Enroll Now
        </a>
        <a
          href="tel:9073352829"
          class="hidden xl:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-teal-900 bg-teal-50 hover:bg-teal-100 rounded-lg transition-colors"
        >
          <svg class="w-3.5 h-3.5 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          (907) 335-2829
        </a>
        
        <!-- Mobile Navigation Drawer Trigger -->
        <MobileNav client:load />
      </div>

    </div>
  </div>
</header>
