---
import { MobileNav } from './MobileNav';
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-sky-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-22 py-2">
      
      <!-- Brand & Official Logo Emblem -->
      <a href="/" class="flex items-center gap-3.5 group">
        <div class="relative w-14 h-14 sm:w-16 sm:h-16 shrink-0 transition-transform duration-300 group-hover:scale-105">
          <img
            src="/images/tulen-logo.png"
            alt="Tułen Charter School Qunshi Beluga Logo"
            class="w-full h-full object-contain drop-shadow-md"
          />
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="font-serif font-extrabold text-sky-950 text-xl sm:text-2xl tracking-tight leading-none group-hover:text-sky-600 transition-colors">
              Tułen Charter School
            </span>
          </div>
          <span class="text-xs text-sky-700 font-bold tracking-wide mt-1">
            Qunshi Beluga &bull; KPBSD Public Charter &bull; Kenaitze Partner
          </span>
        </div>
      </a>

      <!-- Desktop Navigation & Mega Menu -->
      <nav class="hidden lg:flex items-center gap-7 text-sm font-bold text-slate-700">
        <a href="/" class="hover:text-sky-600 transition-colors py-1">Home</a>
        <a href="/about" class="hover:text-sky-600 transition-colors py-1">About</a>
        <a href="/enrollment" class="hover:text-sky-600 transition-colors py-1">Enrollment</a>
        <a href="/staff" class="hover:text-sky-600 transition-colors py-1">Staff</a>
        
        <!-- Desktop Mega Menu Dropdown -->
        <div class="relative group py-1">
          <button class="flex items-center gap-1.5 hover:text-sky-600 transition-colors py-1">
            <span>Explore Campus</span>
            <svg class="w-4 h-4 text-sky-600 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <!-- Mega Menu Panel -->
          <div class="absolute -right-32 top-full hidden group-hover:block w-[780px] bg-white rounded-3xl shadow-2xl border border-sky-100 p-8 z-50 animate-in fade-in slide-in-from-top-3 duration-200">
            <div class="grid grid-cols-3 gap-8">
              
              <!-- Mega Col 1: Academics & Governance -->
              <div class="space-y-4">
                <div class="flex items-center gap-2 border-b border-sky-100 pb-2">
                  <span class="w-2 h-2 rounded-full bg-sky-500"></span>
                  <span class="text-xs font-extrabold uppercase tracking-widest text-sky-700">Governance & Leadership</span>
                </div>
                <ul class="space-y-2.5 text-xs font-medium">
                  <li>
                    <a href="/about" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-sky-50 transition-colors">
                      <span class="text-sky-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-sky-600">About Tułen Charter</strong>
                        <span class="text-[11px] text-slate-500">Mission, vision & tribal partnership</span>
                      </div>
                    </a>
                  </li>
                  <li>
                    <a href="/academic-policy-committee" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-sky-50 transition-colors">
                      <span class="text-sky-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-sky-600">APC Board Governance</strong>
                        <span class="text-[11px] text-slate-500">Board members, agendas & bylaws</span>
                      </div>
                    </a>
                  </li>
                  <li>
                    <a href="/staff" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-sky-50 transition-colors">
                      <span class="text-sky-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-sky-600">Faculty & Staff Directory</strong>
                        <span class="text-[11px] text-slate-500">Meet certified KPBSD educators</span>
                      </div>
                    </a>
                  </li>
                  <li>
                    <a href="/school-profile" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-sky-50 transition-colors">
                      <span class="text-sky-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-sky-600">School Profile & Data</strong>
                        <span class="text-[11px] text-slate-500">State accountability & AK STAR metrics</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>

              <!-- Mega Col 2: Student & Family Life -->
              <div class="space-y-4">
                <div class="flex items-center gap-2 border-b border-sky-100 pb-2">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                  <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700">Family & Student Life</span>
                </div>
                <ul class="space-y-2.5 text-xs font-medium">
                  <li>
                    <a href="/enrollment" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-amber-50 transition-colors">
                      <span class="text-amber-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-amber-700">K-4 Admissions & Lottery</strong>
                        <span class="text-[11px] text-slate-500">Online Intent to Enroll application</span>
                      </div>
                    </a>
                  </li>
                  <li>
                    <a href="/parent-portal" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-amber-50 transition-colors">
                      <span class="text-amber-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-amber-700">Parent Portal & Resources</strong>
                        <span class="text-[11px] text-slate-500">PowerSchool, bus routes & menus</span>
                      </div>
                    </a>
                  </li>
                  <li>
                    <a href="/calendar" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-amber-50 transition-colors">
                      <span class="text-amber-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-amber-700">School Calendar</strong>
                        <span class="text-[11px] text-slate-500">Academic & cultural events filter</span>
                      </div>
                    </a>
                  </li>
                  <li>
                    <a href="/events" class="group/item flex items-start gap-2.5 p-2 rounded-xl hover:bg-amber-50 transition-colors">
                      <span class="text-amber-600 font-bold group-hover/item:translate-x-0.5 transition-transform">&rsaquo;</span>
                      <div>
                        <strong class="text-sky-950 block text-xs group-hover/item:text-amber-700">Events & Celebrations</strong>
                        <span class="text-[11px] text-slate-500">Subsistence Harvest Week & NYO</span>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>

              <!-- Mega Col 3: Dena'ina Heritage & Contact -->
              <div class="space-y-4 bg-sky-950 text-white p-5 rounded-2xl border border-sky-800">
                <div class="flex items-center justify-between border-b border-sky-800 pb-2">
                  <span class="text-[10px] font-extrabold uppercase tracking-widest text-sky-400">Culture Spotlight</span>
                  <span class="text-[10px] font-mono text-sky-300">Qunshi</span>
                </div>
                <div>
                  <h4 class="font-serif font-bold text-sky-300 text-base">Outer Inlet Dena'ina</h4>
                  <p class="text-[11px] text-slate-200 mt-1 leading-relaxed">
                    Celebrating traditional language, Elders circles, and subsistence ecology along Kahtnu waters.
                  </p>
                </div>
                <div class="pt-2 border-t border-sky-900 space-y-2 text-xs">
                  <a href="/newsletter" class="block font-bold text-sky-400 hover:text-white transition-colors">
                    📖 Monthly Newsletters &rarr;
                  </a>
                  <a href="/contact" class="block font-bold text-amber-300 hover:text-white transition-colors">
                    📍 Contact Campus & Map &rarr;
                  </a>
                </div>
              </div>

            </div>
          </div>
        </div>
      </nav>

      <!-- Action Buttons & Mobile Nav Trigger -->
      <div class="flex items-center gap-3">
        <a
          href="/enrollment"
          class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-extrabold text-sm shadow-md transition-all hover:shadow-lg hover:-translate-y-0.5"
        >
          Enroll Now (K-4)
        </a>
        <a
          href="tel:9073352829"
          class="hidden xl:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-extrabold text-sky-900 bg-sky-50 hover:bg-sky-100 rounded-xl transition-colors border border-sky-200"
        >
          <svg class="w-3.5 h-3.5 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          (907) 335-2829
        </a>
        
        <!-- Full-Screen Mobile Navigation Trigger -->
        <MobileNav client:load />
      </div>

    </div>
  </div>
</header>
