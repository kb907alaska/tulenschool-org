---
interface Props {
  word?: string;
  phonetic?: string;
  english?: string;
  culturalNote?: string;
}

const {
  word = "Qunshi & Tułen",
  phonetic = "KOON-shee & too-LEN",
  english = "Beluga Whale & The Flowing River",
  culturalNote = "Qunshi is the Dena'ina word for Beluga Whale, honoring the white beluga whales of Cook Inlet and Kahtnu waters that symbolize strength, navigation, and community."
} = Astro.props;
---

<div class="bg-gradient-to-br from-sky-950 via-slate-950 to-sky-900 text-white rounded-3xl p-8 shadow-2xl border border-sky-400/30 relative overflow-hidden group">
  <!-- Subtle Background Glow -->
  <div class="absolute -right-10 -bottom-10 w-48 h-48 rounded-full bg-sky-500/20 blur-3xl group-hover:bg-sky-400/30 transition-all duration-500"></div>

  <div class="relative z-10 space-y-4">
    <div class="flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-extrabold uppercase tracking-wider border border-sky-400/30">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        Dena'ina Cultural Spotlight
      </span>
      <span class="text-xs text-sky-400 font-mono font-bold">Kenaitze Heritage</span>
    </div>

    <div>
      <h3 class="text-3xl sm:text-4xl font-serif font-extrabold text-sky-300 tracking-tight">
        {word}
      </h3>
      <p class="text-xs font-semibold text-sky-200 mt-1 italic">
        Pronunciation: [{phonetic}]
      </p>
    </div>

    <div class="pt-3 border-t border-sky-800/80">
      <p class="text-sm font-extrabold text-white mb-1">
        "{english}"
      </p>
      <p class="text-xs text-slate-300 leading-relaxed">
        {culturalNote}
      </p>
    </div>
  </div>
</div>
